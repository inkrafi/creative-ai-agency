# See root .env.example for the full explanation of each variable.
NODE_ENV=development
PORT=3000

DATABASE_URL_MIGRATE=postgresql://postgres:postgres@localhost:5433/agency_dev?schema=public
DATABASE_URL=postgresql://app_rls:change_me@localhost:5433/agency_dev?schema=public
DATABASE_URL_AUTH_BYPASS=postgresql://app_auth_bypass:change_me_too@localhost:5433/agency_dev?schema=public

JWT_SECRET=dev_only_change_me
JWT_EXPIRES_IN=1d

# --- AI generation (Phase 1) ---
# Primary provider. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional fallback provider -- only used if Anthropic's quota/credit runs
# out. Get one free at https://aistudio.google.com/apikey. Leave blank to
# disable the fallback (requests just fail when Anthropic is exhausted).
GEMINI_API_KEY=
