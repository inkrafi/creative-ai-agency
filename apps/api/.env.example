# See root .env.example for the full explanation of each variable.
NODE_ENV=development
PORT=3000

DATABASE_URL_MIGRATE=postgresql://postgres:postgres@localhost:5433/agency_dev?schema=public
DATABASE_URL=postgresql://app_rls:change_me@localhost:5433/agency_dev?schema=public
DATABASE_URL_AUTH_BYPASS=postgresql://app_auth_bypass:change_me_too@localhost:5433/agency_dev?schema=public

JWT_SECRET=dev_only_change_me
JWT_EXPIRES_IN=1d

# --- AI generation (Phase 1) ---
# Primary provider. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional fallback provider -- only used if Anthropic's quota/credit runs
# out. Get one free at https://aistudio.google.com/apikey. Leave blank to
# disable the fallback (requests just fail when Anthropic is exhausted).
GEMINI_API_KEY=

# --- Invoice email (client portal) ---
# Optional, like GEMINI_API_KEY above -- leave blank in dev and invoice
# emails just get skipped (the invoice itself is still created and visible
# in-portal; see EmailService). Get a key at https://resend.com.
RESEND_API_KEY=
# Resend's sandbox sender (onboarding@resend.dev) only delivers to the
# email on your own Resend account until you verify a real sending domain.
RESEND_FROM_EMAIL=onboarding@resend.dev
# Base URL of apps/client (the client portal), used for the login link in
# invoice emails.
CLIENT_PORTAL_URL=http://localhost:3002

# --- Client self-signup (POST /auth/client-signup) ---
# Required for that endpoint to work. This deployment is Kravio's own
# single-tenant instance, not resold multi-agency SaaS, so a self-registering
# client always joins this one, already-known Organization. Grab an org id
# from `GET /organizations/me` after logging in as any existing member, or
# from `prisma studio`. Left unset here, the endpoint fails loudly rather
# than guessing which org a new client should land in.
KRAVIO_ORGANIZATION_ID=
