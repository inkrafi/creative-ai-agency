generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Migrations run as the owner role (DATABASE_URL_MIGRATE). The running app
  // overrides this at runtime with `datasourceUrl: process.env.DATABASE_URL`
  // (the RLS-restricted app_rls role) — see PrismaService. Prisma CLI commands
  // (migrate, studio) use this env var directly.
  url      = env("DATABASE_URL_MIGRATE")
}

enum Role {
  AGENCY_ADMIN
  AGENCY_EDITOR
  CLIENT_APPROVER
  CLIENT_VIEWER
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum AssetType {
  TEXT
}

enum GenerationJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum LedgerEntryStatus {
  PENDING
  SETTLED
}

enum BriefType {
  WEBSITE
  DESIGN
}

enum PaymentType {
  DP
  PELUNASAN
  OTHER
}

/// Client-submitted proof-of-payment claims start PENDING and don't count
/// toward a project's paid total until a staff member reviews the image
/// against what was expected. Staff-direct entries (the original flow --
/// staff already confirmed the money arrived before recording it) skip this
/// entirely and default straight to VERIFIED.
enum PaymentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// A tenant. Every other tenant-scoped table carries an organization_id
/// column that Postgres RLS policies filter on (see migrations/0002_rls_policies).
model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users    User[]
  projects Project[]

  @@map("organizations")
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  email          String   @unique
  passwordHash   String   @map("password_hash")
  name           String
  role           Role
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("users")
}

model Project {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  name           String
  description    String?
  status         ProjectStatus @default(ACTIVE)
  // Whole Rupiah, no fractional subunit in real use -- a plain Int, not the
  // "micros" pattern GenerationJob/CreditLedgerEntry use (that exists for
  // fractional per-token USD pricing, a different problem). Nullable: the
  // price is usually agreed after the initial brief discussion, not known
  // at project creation.
  totalPriceIdr  Int?          @map("total_price_idr")
  // Informational only -- shown as plain text on the invoice ("minimum DP:
  // X%"), never enforced against what a client actually submits. Set
  // whenever an invoice is sent; nullable because a project can go a long
  // time before it has a price at all.
  minDpPercent   Int?          @map("min_dp_percent")
  // Which CLIENT_APPROVER this project belongs to -- the isolation boundary
  // *between different clients of the same agency*, layered on top of (not
  // instead of) RLS's organization-level tenant isolation. Null for
  // staff-created projects (today's original flow, still supported); set
  // automatically when a client self-creates a project. A client's reads
  // are filtered to clientOwnerId = themselves (see
  // assertClientOwnsProject() in common/client-project-access.ts); staff
  // are never restricted by this field.
  clientOwnerId  String?       @map("client_owner_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  tasks        Task[]
  briefs       Brief[]
  payments     Payment[]
  invoices     Invoice[]

  @@index([organizationId])
  @@index([clientOwnerId])
  @@map("projects")
}

/// A generation request: "draft this content". Groups one or more Tasks —
/// matches the design doc's Organization -> Project -> Brief -> Task ->
/// Asset(versions) data shape.
///
/// `type` + `context` replace a single free-text instructions field so the
/// intake actually captures client discovery info (business type, pain
/// points, goals, ...) instead of whatever the user happens to type --
/// see the WEBSITE/DESIGN field shapes in briefs/brief-context.ts.
/// `instructions` is now server-computed (formatted from type+context at
/// create time, not client-supplied) and kept so the exact prompt sent to
/// the model is on record even if the formatting logic changes later.
model Brief {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  projectId      String    @map("project_id") @db.Uuid
  title          String
  type           BriefType
  context        Json
  instructions   String
  // Set by BriefsService.suggestPrice() -- an AI-generated starting point
  // for staff, never applied to Project.totalPriceIdr automatically. Staff
  // reviews/edits the number before it becomes a real invoice; see
  // ProjectsService's invoice-sending flow, which is what actually sets
  // the project's price.
  aiSuggestedPriceIdr Int?    @map("ai_suggested_price_idr")
  aiPriceReasoning    String? @map("ai_price_reasoning")
  createdById    String    @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  project  Project   @relation(fields: [projectId], references: [id])
  tasks    Task[]
  invoices Invoice[]

  @@index([organizationId])
  @@index([projectId])
  @@map("briefs")
}

model Task {
  id             String     @id @default(uuid()) @db.Uuid
  // Denormalized from project.organizationId so the RLS policy can filter
  // directly on this table without a join. Keep this pattern for
  // assets/generation jobs/ledger entries in later phases too.
  organizationId String     @map("organization_id") @db.Uuid
  projectId      String     @map("project_id") @db.Uuid
  briefId        String?    @map("brief_id") @db.Uuid
  title          String
  description    String?
  status         TaskStatus @default(TODO)
  // How many client-requested revision rounds are included before it's a
  // new arrangement -- checked by TasksService.requestRevision(). Default
  // of 2 is a reasonable agency norm, not a hard business rule; adjust
  // per-task via PATCH until there's a real reason to make it configurable
  // per project/contract.
  maxRevisions   Int        @default(2) @map("max_revisions")
  revisionsUsed  Int        @default(0) @map("revisions_used")
  createdById    String     @map("created_by_id") @db.Uuid
  assignedToId   String?    @map("assigned_to_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  project           Project           @relation(fields: [projectId], references: [id])
  brief             Brief?            @relation(fields: [briefId], references: [id])
  assets            Asset[]
  generationJobs    GenerationJob[]
  deliverables      Deliverable[]
  revisionRequests  RevisionRequest[]

  @@index([organizationId])
  @@index([projectId])
  @@index([briefId])
  @@map("tasks")
}

/// One generated draft. `version` increments each time a Task's brief is
/// (re)generated -- this is the "Asset (versions)" data shape from the
/// design doc, kept minimal (text only) -- image generation was tried in an
/// earlier iteration and removed: the AI's output is always a starting
/// point for a human designer/developer on the agency's own team, never a
/// generated final asset. See brief-context.ts's BRIEF_SYSTEM_PROMPTS comment.
model Asset {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  taskId         String    @map("task_id") @db.Uuid
  type           AssetType @default(TEXT)
  content        String
  version        Int
  createdById    String    @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id])

  @@unique([taskId, version])
  @@index([organizationId])
  @@index([taskId])
  @@map("assets")
}

/// What actually gets shown to the client for review -- a link to the real,
/// human-made work (a staging URL, a design file, whatever fits the brief),
/// not the AI draft in Asset. One row per submitForReview() call, versioned
/// the same way Asset is, so re-submitting after a revision round doesn't
/// erase what was shown last time. Required (not optional) precisely
/// because "submit for review" with nothing concrete for the client to
/// look at isn't a real review request.
model Deliverable {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  taskId         String   @map("task_id") @db.Uuid
  url            String
  note           String?
  version        Int
  createdById    String   @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id])

  @@unique([taskId, version])
  @@index([organizationId])
  @@index([taskId])
  @@map("deliverables")
}

/// What the client actually asked to have changed -- one row per
/// requestRevision() call, `round` matching the Task.revisionsUsed value
/// after that request. `note` is required, not optional: a revision
/// request with no explanation of what's wrong leaves the designer/
/// developer with nothing to act on, defeating the point of tracking this
/// at all.
model RevisionRequest {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  taskId         String   @map("task_id") @db.Uuid
  note           String
  round          Int
  createdById    String   @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id])

  @@unique([taskId, round])
  @@index([organizationId])
  @@index([taskId])
  @@map("revision_requests")
}

/// A manually-recorded payment against a Project's totalPriceIdr -- no
/// payment gateway, no automated reconciliation; staff records what came in
/// (bank transfer, cash, QRIS, whatever) after the fact. Append-only, like
/// CreditLedgerEntry: a project's paid-so-far amount is SUM(payments), not
/// a stored balance column that could drift from what was actually
/// recorded. `type` is a label the staff member picks (DP for the initial
/// deposit, PELUNASAN for the payment that's meant to close it out, OTHER
/// for anything else) -- not enforced ordering or exclusivity, since this
/// is bookkeeping for humans who already know their own arrangement with
/// the client, not a payment gateway state machine.
model Payment {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  projectId      String      @map("project_id") @db.Uuid
  type           PaymentType
  amountIdr      Int         @map("amount_idr")
  method         String
  note           String?
  recordedById   String      @map("recorded_by_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at")
  // Data-URI image the client attached as proof when self-submitting a
  // claim (ProjectsService.claimPayment) -- null for staff-direct entries,
  // which have no claim step to prove. Stored inline in Postgres rather
  // than object storage for now: no cloud storage is wired up anywhere in
  // this codebase yet, and this keeps the feature shippable without adding
  // that dependency. Known tradeoff (DB bloat on large images) -- worth
  // moving to real object storage (S3/R2) before this sees heavy volume.
  proofImageUrl      String?                   @map("proof_image_url")
  // VERIFIED by default: a staff-direct entry means staff already confirmed
  // the money arrived before recording it, so there's nothing to verify.
  // Only claimPayment() (the client-facing path) creates PENDING rows.
  verificationStatus PaymentVerificationStatus @default(VERIFIED) @map("verification_status")
  verifiedById       String?                   @map("verified_by_id") @db.Uuid
  verifiedAt         DateTime?                 @map("verified_at")

  project Project @relation(fields: [projectId], references: [id])

  @@index([organizationId])
  @@index([projectId])
  @@map("payments")
}

/// A historical record of a priced-and-sent invoice -- kept as its own
/// table (not just fields on Project) because it's a snapshot: if the price
/// is corrected later with a new invoice, the old amount stays on record
/// rather than being overwritten, and the client portal needs something
/// concrete to list/display, not just a mutating number. Sending one is
/// also what actually sets Project.totalPriceIdr/minDpPercent -- see
/// ProjectsService.sendInvoice().
model Invoice {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  projectId      String    @map("project_id") @db.Uuid
  briefId        String?   @map("brief_id") @db.Uuid
  amountIdr      Int       @map("amount_idr")
  minDpPercent   Int?      @map("min_dp_percent")
  createdById    String    @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  // Null if the email send failed or Resend isn't configured -- the invoice
  // still exists and is visible in-portal either way; see EmailService.
  emailSentAt    DateTime? @map("email_sent_at")

  project Project @relation(fields: [projectId], references: [id])
  brief   Brief?  @relation(fields: [briefId], references: [id])

  @@index([organizationId])
  @@index([projectId])
  @@map("invoices")
}

/// One AI generation call. Exists from Phase 1 purely for instrumentation --
/// billing itself ships in Phase 3, but usage/cost can't be reconstructed
/// retroactively for calls that were never logged.
model GenerationJob {
  id                  String              @id @default(uuid()) @db.Uuid
  organizationId      String              @map("organization_id") @db.Uuid
  taskId              String              @map("task_id") @db.Uuid
  createdById         String              @map("created_by_id") @db.Uuid
  provider            String              @default("anthropic")
  model               String
  status              GenerationJobStatus @default(PENDING)
  promptTokens        Int?                @map("prompt_tokens")
  completionTokens    Int?                @map("completion_tokens")
  // Cost tracked in micros (millionths of a dollar) to avoid float rounding
  // on per-token pricing. 1_000_000 micros = $1.00.
  estimatedCostMicros Int                 @map("estimated_cost_micros")
  actualCostMicros    Int?                @map("actual_cost_micros")
  errorMessage        String?             @map("error_message")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  task          Task                @relation(fields: [taskId], references: [id])
  ledgerEntries CreditLedgerEntry[]

  @@index([organizationId])
  @@index([taskId])
  @@map("generation_jobs")
}

/// Append-only ledger, never a mutated balance column -- avoids the
/// double-spend race where two concurrent requests both read the same
/// stale balance. Tenant balance = SUM(amountMicros). A generation request
/// inserts a PENDING debit (the "hold") before calling the model at all;
/// it's corrected to the real cost (SETTLED) after, or removed on failure.
model CreditLedgerEntry {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @map("organization_id") @db.Uuid
  amountMicros    Int               @map("amount_micros")
  status          LedgerEntryStatus @default(SETTLED)
  generationJobId String?           @map("generation_job_id") @db.Uuid
  reason          String?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  generationJob GenerationJob? @relation(fields: [generationJobId], references: [id])

  @@index([organizationId])
  @@map("credit_ledger_entries")
}
